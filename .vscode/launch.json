{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FastAPI local demo",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: smoke test (start API first)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/smoke.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
