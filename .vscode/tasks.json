{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup local environment (Windows)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/setup.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Run API (local)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Verify: tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Verify: Ruff",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "check", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Evaluate retrieval baseline",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/evaluate.py", "--output", "reports/evaluation.json"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
