# Copy to .env. The default is an offline engineering demo, without external API charges.
APP_ENV=local
DATABASE_URL=sqlite:///./data/knowledge.db
STORAGE_DIR=data/uploads
JWT_SECRET=local-demo-only-change-before-deployment-32chars
JWT_EXPIRE_MINUTES=120
TASK_MODE=local
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_BACKEND=memory
AUTO_CREATE_SCHEMA=true

# hash = deterministic lexical baseline; demo = extractive answer, not an LLM.
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=256
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=configure-your-model
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=800
MAX_CONCURRENT_GENERATIONS=4

CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.08
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_CHARS=1000000
MAX_PDF_PAGES=300
CHAT_REQUESTS_PER_MINUTE=20
AUTH_REQUESTS_PER_MINUTE=20
JOB_LEASE_SECONDS=900
JOB_MAX_ATTEMPTS=3

# Docker Compose also reads .env. Set both values before docker compose up.
# Compose overrides APP_ENV, DATABASE_URL, REDIS_URL, TASK_MODE and storage paths.
# Use URL-safe random secrets (e.g. secrets.token_urlsafe(36)) for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=

